# No credentials belong in this file or in Git. Copy locally to ignored .env.
APP_ORIGIN=http://localhost:3000
PORT=3000
PRODUCT_ID=forma-premium
# Optional: only documented ingress proxy IPs/CIDRs from your host. Never true/all.
TRUST_PROXY_CIDRS=
SUPABASE_URL=https://lbbdwjgwjpymfysblsbj.supabase.co
# Supabase Settings > API Keys > Publishable key (or legacy anon key).
SUPABASE_PUBLISHABLE_KEY=
# Connect > Connection string > Session pooler, with sslmode=verify-full.
# Configure the Supabase CA via PGSSLROOTCERT if the host needs it.
DATABASE_URL=
# Independent 32-byte random secrets, encoded as 64 hex characters.
DATA_ENCRYPTION_KEY=
ACTIVATION_HMAC_KEY=
# Mercado Pago > Your integrations > application > Test credentials.
# Checkout Pro uses Preferences, not Orders API or Subscriptions.
MP_MODE=test
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
# Resend > API Keys (sending access to the verified domain).
RESEND_API_KEY=
EMAIL_FROM=
